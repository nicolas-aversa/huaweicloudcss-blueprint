# Secretos: el .env real NUNCA debe versionarse.
.env
# Settings de la plataforma (⚙ Configuración): puede traer la API key de MaaS.
.platform_settings.json

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Cache local de wrangler (lo deja `npx wrangler deploy` del panel de la ECS).
.wrangler/


# Datasets grandes (no versionar; se bajan del Release o build scripts). Entre
# .log y .csv pasan de 1,2 GB → nunca commitearlos.
datasets/*.log
datasets/train_identity.csv
datasets/train_transaction.csv

# Terraform: estado, lockfiles, y los .tfvars que pueden traer secrets.
# Solo versionamos terraform.tfvars.example y main.tf (el HCL).
terraform/.terraform/
terraform/.terraform.lock.hcl
terraform/terraform.tfvars
terraform/terraform.tfstate
terraform/terraform.tfstate.backup
terraform/*.tfstate.*
# El endpoint /terraform/deploy escribe este archivo con AK/SK y lo borra
# al final, pero por si quedó colgado tras un crash, gitignorearlo evita
# que se commitee por accidente.
terraform/deploy.auto.tfvars.json
# El pipeline.conf también puede tener creds inyectadas (user/password
# del cluster). Se regenera por deploy, no hace falta versionarlo.
terraform/pipeline.conf
terraform/*.auto.tfvars.json
terraform/.pipelines.json
# Marcadores del entorno desplegado en single-user (fecha del deploy, el index
# template aplicado, los IDs de modelos/agentes de capabilities): estado de UNA
# máquina, no del repo. Dos de ellos se colaron en un commit con `git add -A`.
terraform/.platform_deploy.json
terraform/.index_template.json
terraform/.capabilities.json
# Backend remoto del state (OBS): lo genera tfstate.prepare() por workspace y
# lleva las AK/SK del bucket en claro, igual que destroy.auto.tfvars.json.
terraform/backend.tf

# Hosting multi-SA: datos por-usuario (settings + terraform + state + user store,
# con credenciales) y el env con el secreto de sesión. NUNCA versionar.
data/
.env.hosted
# Historial de ejecuciones en single-user (en hosted vive bajo data/).
runs/
