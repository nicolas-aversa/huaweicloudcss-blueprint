# Config OPCIONAL de la app. Copiá a `.env` si querés fijar estos valores por
# entorno; si no, todo se configura por la UI (⚙ Configuración). Con Docker el
# `.env` es opcional (docker-compose lo toma si existe).

# --- Huawei Cloud account ---
# Project ID de la cuenta + región (la-south-2). 32 hex chars sin guiones.
# Lo obtenés desde la consola Huawei → My Credentials → API Credentials.
# Se usa para armar la URL de consola Kibana del cluster post-deploy.
HUAWEI_PROJECT_ID=

# --- Huawei Cloud ModelArts as a Service (MaaS) ---
# API Key del servicio MaaS. Puede quedar vacía acá: se configura por UI en
# ⚙ Configuración (se guarda en los settings, con prioridad sobre esta).
MAAS_API_KEY=

# Endpoint MaaS compatible con la API de OpenAI.
MAAS_BASE_URL=https://api.modelarts-maas.com/v1

# Modelos del agente conversacional de OpenSearch (ml-commons).
# LLM: razona y frasea la respuesta. PPL: genera queries PPL desde NL.
MAAS_LLM_MODEL=deepseek-v4-flash
MAAS_PPL_MODEL=deepseek-v4-flash

# Modelo para la generación del filter de Logstash (maas_integrator).
MAAS_PIPELINE_MODEL=glm-5.3

# Modo thinking del generador de pipeline (enabled|disabled). GLM razona el
# parseo (plugin, namespacing, @timestamp) antes de emitir el JSON — en un CSV
# de 14 columnas son ~9.400 tokens de razonamiento, y es de donde sale que el
# .conf compile a la primera. OJO: glm-5.3 razona SIEMPRE y rechaza que se lo
# configuren (400 ModelArts.81001 con `disabled`); la app lo detecta y manda la
# llamada sin el parámetro, así que apagarlo ahí no tiene efecto. Con glm-5.2 sí.
MAAS_PIPELINE_THINKING=enabled
