# No hornear en la imagen: secretos, estado, data pesada, caches.
.git
.gitignore
.dockerignore
Dockerfile
docker-compose.yml
docker-compose.hosted.yml

# Secretos / estado (se inyectan/mapean en runtime)
.env
.env.hosted
.platform_settings.json
# Hosting multi-SA: workspaces por-usuario (se montan como volumen en runtime).
data/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.pytest_cache/

# Datasets (GB) — se regeneran con los build scripts / se suben a OBS
datasets/*.log
datasets/*.csv

# Lo que no corre en producción. El Dockerfile hace `COPY . .`, así que sin esto
# la imagen se lleva los tests, el panel de la ECS (que se despliega aparte, en
# FunctionGraph + Cloudflare) y los dashboards ya generados, que el backend
# reconstruye desde `verticals/` en runtime.
tests/
ecs-panel/
docs/dashboards/
build_*.py

# Terraform: estado y providers
terraform/.terraform/
terraform/terraform.tfvars
terraform/*.tfstate
terraform/*.tfstate.*
terraform.tfstate

terraform/*.auto.tfvars.json
terraform/.pipelines.json
terraform/pipeline.conf
terraform/backend.tf
