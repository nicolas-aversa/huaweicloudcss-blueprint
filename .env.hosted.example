# Config del despliegue HOSTEADO multi-SA. TODO ES OPCIONAL: podés levantar sin
# tocar nada de esto (zero-config) y funciona por HTTP con auth activada.
#   docker compose -f docker-compose.hosted.yml up --build -d
# Copiá a `.env.hosted` solo si querés fijar alguno de estos valores.

# Dominio público → HTTPS automático (su DNS debe apuntar a la IP; 80/443 abiertos).
# Si lo dejás vacío, sirve por HTTP en :80 (sin TLS, sin dominio).
APP_DOMAIN=

# Secreto para firmar sesiones. Si lo dejás vacío, el contenedor AUTOGENERA uno
# estable y lo guarda en el volumen (no hace falta cargarlo). Fijalo solo si querés
# el mismo secreto en varios hosts.  (generar: openssl rand -hex 32)
APP_SECRET_KEY=

# Emails de los SAs autorizados (coma/espacio). Vacío = registro abierto (cualquiera
# se crea cuenta). Se puede gestionar después desde el panel de Administración.
SA_ALLOWLIST=

# Emails ADMIN. Vacío = el PRIMER usuario que se registra queda como admin (y desde
# la UI gestiona allowlist/usuarios). Fijalo si querés admins explícitos.
SA_ADMINS=

# Duración de la sesión en segundos (default 7 días).
SESSION_TTL_SECONDS=604800

# ── Guardrails de costo (opcionales) ──
# Tope duro de pipelines por usuario (default 0 = SIN límite; la plataforma escala
# el flavor y reparte los workers de Logstash entre las pipelines). Poné >0 solo si
# querés un techo fijo.
MAX_PIPELINES_PER_USER=0
# Auto-destroy de entornos demo más viejos que N horas (0 = APAGADO). Ojo: destruye
# infra automáticamente con las creds guardadas del deploy; usalo solo para demos
# efímeras. Chequeo cada ENV_TTL_CHECK_SECONDS (default 1800).
ENV_TTL_HOURS=0
ENV_TTL_CHECK_SECONDS=1800
