# Config del despliegue HOSTEADO multi-SA. Copiá a `.env.hosted` y completá.
#   docker compose -f docker-compose.hosted.yml --env-file .env.hosted up --build -d

# Dominio público (su DNS debe apuntar a la IP de esta máquina; 80/443 abiertos).
APP_DOMAIN=accel.tudominio.com

# Secreto para firmar sesiones y activar auth. Generá uno fuerte y NO lo compartas:
#   openssl rand -hex 32
APP_SECRET_KEY=

# Emails de los SAs autorizados (coma/espacio). Vacío = registro abierto (no
# recomendado en producción). El primer login de cada uno crea su cuenta.
SA_ALLOWLIST=vos@huawei.com, colega@huawei.com

# Emails con permisos de ADMIN (subconjunto de la allowlist): ven el panel de
# Administración (resetear contraseñas de usuarios + audit log). Vacío = sin admins.
SA_ADMINS=vos@huawei.com

# Duración de la sesión en segundos (default 7 días).
SESSION_TTL_SECONDS=604800

# ── Guardrails de costo (opcionales) ──
# Tope duro de pipelines por usuario (default 0 = SIN límite; la plataforma escala
# el flavor y reparte los workers de Logstash entre las pipelines). Poné >0 solo si
# querés un techo fijo.
MAX_PIPELINES_PER_USER=0
# Auto-destroy de entornos demo más viejos que N horas (0 = APAGADO). Ojo: destruye
# infra automáticamente con las creds guardadas del deploy; usalo solo para demos
# efímeras. Chequeo cada ENV_TTL_CHECK_SECONDS (default 1800).
ENV_TTL_HOURS=0
ENV_TTL_CHECK_SECONDS=1800
